# Garmin Connect credentials.
# The server first tries saved tokens in GARMINCONNECT_TOKEN_DIR.
# Credentials are only needed for initial login or token refresh failures.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Token directory used by python-garminconnect.
GARMINCONNECT_TOKEN_DIR=~/.garminconnect

# Optional one-time MFA code for non-interactive login attempts.
# Prefer logging in once from a terminal when MFA is enabled.
GARMIN_MFA_CODE=

